PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/factcheck_ai?retryWrites=true&w=majority

# Gemini API Key & Model (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google Fact Check Tools API Key
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# News API Key (Get from newsapi.org)
NEWS_API_KEY=your_news_api_key_here

FIREBASE_PROJECT_ID=factcheck-ai-app
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_MODERATOR=1000
